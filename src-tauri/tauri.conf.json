{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "鱼跃CRM",
  "version": "0.1.2",
  "identifier": "com.tonwin.financial",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "鱼跃CRM",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "dbs": [
        "sqlite:financial.db"
      ]
    },
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/lingxyun/tonwinn/main-tauri/update.json"
      ],
      "pubkey": "RWTzW5WOBc6af9HX+QD4IYsA9V3KlNYyOH1hk+BqtVGHMmOLEP9qVKj"
    },
    "process": {}
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}